# ==============================================================================
# THREATNEX AI-IDS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your environment-specific credentials.
# In Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# Flask Session Encryption Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
THREATNEX_SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# Environment Mode ('production' or 'development')
FLASK_ENV=production

# Enforce Secure HTTPS-Only Session Cookies (Set to '1' in production/HTTPS, '0' for local HTTP)
SESSION_COOKIE_SECURE=1

# Production Database Connection URL (Neon / Vercel Postgres / Supabase)
# Leave commented or empty to default to local SQLite (ids.db) during development.
# DATABASE_URL=postgresql://threatnex_admin:SuperSecretPassword@ep-xyz-123.us-east-2.aws.neon.tech/threatnex?sslmode=require

# Vercel Fluid Compute: Enables up to 5 GB function size limit for ML workloads
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Application Server Port (Local execution)
PORT=5000

